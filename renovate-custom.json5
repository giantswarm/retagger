// Repo-owned Renovate rules; renovate.json5 is generated by `devctl gen renovate`
// and extends this file last.
{
  packageRules: [
    {
      // The skopeo release is pinned twice: the ARG in the Dockerfile (the FROM stage
      // whose trust policies are copied, and the git tag the static binary is built
      // from) and the validate-skopeo job's image in .circleci/config.yml. One PR moves both.
      description: "One PR per skopeo release across the Dockerfile and the CircleCI config.",
      groupName: "skopeo",
      matchPackageNames: ["gsoci.azurecr.io/giantswarm/skopeo"],
    },
  ],
}
